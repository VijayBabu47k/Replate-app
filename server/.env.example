# PostgreSQL connection — replace YOUR_PASSWORD with your local postgres password
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/rescue_surplus?schema=public"

PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_URL="http://localhost:5173"

# Volunteer payouts: true marks payout requests as paid immediately (demo).
# false keeps them PENDING until you settle them with `npm run payouts:settle`.
PAYOUT_AUTO_SETTLE=true

# --- Email (Nodemailer) ---
# MAIL_MODE options:
#   log      -> no network; emails are stored in the EmailLog table (view them in the app's "Email outbox")
#   gmail    -> real delivery through Gmail with an App Password (see GMAIL_* below)
#   smtp     -> any SMTP server using the SMTP_* settings below
#   ethereal -> creates a free Ethereal test inbox; each email gets a preview URL
MAIL_MODE=log

# Gmail with an App Password (MAIL_MODE=gmail)
#   1. Turn on 2-Step Verification for the Google account
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character code below (spaces are fine, they are removed)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Demo accounts use fake addresses (@demo.rescue). Their emails are delivered to this inbox
# instead (real users always get their own). Leave blank to skip demo-account emails.
MAIL_REDIRECT_TO=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vijaybabu47k@gmail.com
SMTP_PASS="rtta aowq hcmb bslb"
MAIL_FROM="RePlate <vijaybabu47k@gmail.com>"
